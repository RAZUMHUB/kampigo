import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

async function main() {
  const university = await prisma.university.upsert({
    where: { slug: 'demo-university' },
    create: { name: 'Demo University', slug: 'demo-university', status: 'ACTIVE' },
    update: {},
  });

  await prisma.approvedEmailDomain.upsert({
    where: { universityId_domain: { universityId: university.id, domain: 'demo-university.edu' } },
    create: { universityId: university.id, domain: 'demo-university.edu' },
    update: {},
  });

  const campus = await prisma.campus.upsert({
    where: { id: 'seed-main-campus' },
    create: { id: 'seed-main-campus', universityId: university.id, name: 'Main Campus' },
    update: {},
  });

  await prisma.building.upsert({
    where: { id: 'seed-engineering-block' },
    create: { id: 'seed-engineering-block', campusId: campus.id, name: 'Engineering Block' },
    update: {},
  });

  const categories = ['Electronics', 'Keys', 'Wallet/ID', 'Bags', 'Documents', 'Bottles', 'Accessories', 'Other'];
  for (const name of categories) {
    await prisma.itemCategory.upsert({
      where: { id: `seed-category-${name}` },
      create: { id: `seed-category-${name}`, name, isGlobal: true },
      update: {},
    });
  }

  console.log('Seed complete:', { universityId: university.id });
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(() => prisma.$disconnect());
